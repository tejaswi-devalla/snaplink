# Copy to .env for local Docker Compose usage. Keep .env out of Git.
ENVIRONMENT=development
APP_NAME=SnapLink
DATABASE_URL=postgresql+asyncpg://snaplink:change-me-locally@db:5432/snaplink
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_API_KEY=dev-only-change-this-to-a-long-random-secret
AUTO_CREATE_TABLES=false
CORS_ORIGINS=[]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
CREATE_LIMIT=10
CREATE_WINDOW_SECONDS=3600
STATS_LIMIT=60
STATS_WINDOW_SECONDS=60
REDIRECT_LIMIT=300
REDIRECT_WINDOW_SECONDS=60
REPORT_LIMIT=5
REPORT_WINDOW_SECONDS=3600
MAX_URL_LENGTH=4096
SHORT_CODE_LENGTH=8
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1,::1
DB_PASSWORD=change-me-locally
